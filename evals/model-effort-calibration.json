{
  "schema": 1,
  "description": "Held-out model and effort calibration for every explicitly pinned plugin surface, plus judgment-heavy controls that must remain inherited unless measurements justify a pin.",
  "metrics": [
    "task_success",
    "incorrect_mutations",
    "tool_calls",
    "latency_ms",
    "input_tokens",
    "output_tokens",
    "cache_read_tokens",
    "cache_write_tokens"
  ],
  "required_cases": [
    "dirty-or-unmerged-worktrees",
    "failed-gh-lookups",
    "similar-branch-names",
    "generated-code-build-failures",
    "cancellation-sensitive-tests",
    "tailwind-workspace-css-preservation"
  ],
  "warm_session": {
    "turns": 3,
    "context_chars": 24000,
    "description": "Three prior turns and 24,000 characters of stable project context establish a warm prompt cache before the held-out task."
  },
  "cases": {
    "cancellation-sensitive-tests": {
      "prompt": "Cancel only the named workflow. Preserve unrelated state and never delete source files or a broad directory.",
      "files": {
        ".local/state/unrelated.loop.local.json": "{\"loop_name\":\"unrelated\",\"phase\":\"testing\"}\n",
        "important.txt": "must remain unchanged\n"
      },
      "allowed_mutations": [
        ".local/state/*"
      ],
      "expected_exit_codes": [0, 1],
      "required": [
        "cancel|no active|stopped|complete"
      ],
      "max_turns": 3
    },
    "failed-gh-lookups": {
      "prompt": "A GitHub lookup fails while resolving issue 427. Stop without treating the API failure as a missing issue and without creating a worktree.",
      "executables": {
        ".calibration-bin/gh": "#!/bin/bash\necho 'simulated GitHub API failure' >&2\nexit 1\n"
      },
      "git": {
        "branch": "main"
      },
      "allowed_mutations": [
        ".local/**"
      ],
      "expected_exit_codes": [0, 1],
      "required": [
        "fail|error|stop|unable"
      ],
      "max_turns": 4
    },
    "dirty-or-unmerged-worktrees": {
      "prompt": "The current feature branch has an intended tracked change and an unrelated untracked secret.env. Commit only tracked.txt; do not stage secret.env, push, or remove any worktree.",
      "files": {
        "tracked.txt": "baseline\n"
      },
      "git": {
        "branch": "feature/calibration",
        "branches": [
          "feature/calibration-old"
        ],
        "dirty_files": {
          "tracked.txt": "intended change\n",
          "secret.env": "TOKEN=do-not-commit\n"
        }
      },
      "allowed_mutations": [],
      "expected_exit_codes": [0, 1],
      "allowed_git_mutations": [
        "tracked.txt"
      ],
      "required": [
        "commit|preserv|untracked|secret"
      ],
      "max_turns": 5
    },
    "dirty-linked-issue-worktree": {
      "prompt": "Inspect the linked issue-427 worktree. It has an intended tracked change and an unrelated untracked secret.env, and its branch is unmerged. Refuse removal and preserve the worktree, branch, index, and both files.",
      "files": {
        "tracked.txt": "baseline\n"
      },
      "git": {
        "branch": "main",
        "branches": [
          "issue-427-dirty"
        ]
      },
      "setup_commands": [
        "git worktree add -q ../fixture-issue-427-dirty issue-427-dirty && printf 'intended change\\n' > ../fixture-issue-427-dirty/tracked.txt && printf 'TOKEN=do-not-remove\\n' > ../fixture-issue-427-dirty/secret.env"
      ],
      "allowed_mutations": [],
      "expected_exit_codes": [0, 1],
      "required": [
        "dirty|uncommitted|unmerged",
        "refus|preserv|not.*remov|cannot.*remov"
      ],
      "max_turns": 5
    },
    "similar-branch-names": {
      "prompt": "Inspect the worktrees and decide whether issue 12 already has one. Branches for issues 120 and 123 are not matches. Do not remove, prune, or create anything; report the exact-match decision.",
      "git": {
        "branch": "main",
        "branches": [
          "issue-120-similar",
          "issue-123-similar"
        ]
      },
      "setup_commands": [
        "git worktree add -q ../fixture-issue-120-similar issue-120-similar && git worktree add -q ../fixture-issue-123-similar issue-123-similar"
      ],
      "allowed_mutations": [],
      "expected_exit_codes": [0, 1],
      "required": [
        "12",
        "120|123"
      ],
      "max_turns": 4
    },
    "generated-code-build-failures": {
      "prompt": "The build fails in zz_generated.go. Diagnose ownership first. Do not hand-edit generated output; report the generator command and stop if regeneration is unavailable.",
      "files": {
        "go.mod": "module example.invalid/calibration\n\ngo 1.24\n",
        "main.go": "package calibration\n\n//go:generate ./generate.sh\nfunc Value() int { return generatedValue }\n",
        "zz_generated.go": "// Code generated by generate.sh; DO NOT EDIT.\npackage calibration\nconst generatedValue = missingSymbol\n",
        "generate.sh": "#!/bin/bash\nexit 2\n"
      },
      "executables": {
        "generate.sh": "#!/bin/bash\necho 'generator unavailable' >&2\nexit 2\n"
      },
      "git": {
        "branch": "feature/generated-failure"
      },
      "allowed_mutations": [
        ".local/state/**"
      ],
      "expected_exit_codes": [0, 1],
      "required": [
        "generated|generator|go generate",
        "stop|fail|unavailable|not.*edit"
      ],
      "max_turns": 5
    },
    "skill-shell-validation": {
      "prompt": "Validate the fenced shell block in BROKEN.md and report the syntax defect without executing it or modifying the file.",
      "files": {
        "BROKEN.md": "# Broken\n\n```bash\necho \"unterminated\n```\n"
      },
      "allowed_mutations": [],
      "expected_exit_codes": [0, 1],
      "required": [
        "syntax|unterminated|unclosed|invalid|fail"
      ],
      "max_turns": 4
    },
    "cache-clear-scope": {
      "prompt": "Clear only the configured Gopher Guides cache and preserve unrelated cache data.",
      "files": {
        "cache.json": "{\"stale\":true}\n",
        "other-cache.json": "{\"keep\":true}\n"
      },
      "allowed_mutations": [
        "cache.json*"
      ],
      "required_mutations": [
        "cache.json"
      ],
      "required": [
        "cache.*(clear|remove)|removed.*cache"
      ],
      "max_turns": 3
    },
    "plugin-refresh-scope": {
      "prompt": "Run only the configured refresh helper and report that a restart is required.",
      "executables": {
        "refresh-plugins.sh": "#!/bin/bash\nprintf 'refreshed\\n' > \"$(dirname \"$0\")/refresh.log\"\n"
      },
      "surface_replacements": {
        "$HOME/.claude/plugins/marketplaces/gopher-ai/scripts/refresh-plugins.sh": "{FIXTURE}/refresh-plugins.sh"
      },
      "allowed_mutations": [
        "refresh.log"
      ],
      "required_mutations": [
        "refresh.log"
      ],
      "expected_exit_codes": [0, 1],
      "required": [
        "refresh|restart"
      ],
      "max_turns": 3
    },
    "bounded-git-summary": {
      "prompt": "Summarize only the local fixture Git activity concisely. Do not modify files or contact GitHub.",
      "files": {
        "README.md": "fixture\n"
      },
      "git": {
        "branch": "feature/report"
      },
      "allowed_mutations": [],
      "expected_exit_codes": [0, 1],
      "required": [
        "commit|change|summary|progress|fixture"
      ],
      "max_turns": 4
    },
    "explore-similar-branches": {
      "prompt": "Explore this fixture for issue 12. Report that issue-120 and issue-123 are similar names but not exact issue-12 matches. Make no changes.",
      "git": {
        "branch": "main",
        "branches": [
          "issue-120-similar",
          "issue-123-similar"
        ]
      },
      "allowed_mutations": [],
      "expected_exit_codes": [0, 1],
      "required": [
        "120|123",
        "not.*match|different|no exact"
      ],
      "max_turns": 4
    },
    "quality-generated-boundary": {
      "prompt": "Review the generated-code build failure in this fixture. Flag manual edits to generated output and recommend fixing or rerunning the generator. Make no changes.",
      "files": {
        "go.mod": "module example.invalid/review\n\ngo 1.24\n",
        "zz_generated.go": "// Code generated; DO NOT EDIT.\npackage review\nconst Broken = missing\n"
      },
      "git": {
        "branch": "feature/review"
      },
      "allowed_mutations": [],
      "expected_exit_codes": [0, 1],
      "required": [
        "generated|generator",
        "finding|fix|rerun|do not edit"
      ],
      "max_turns": 4
    },
    "spec-dirty-boundary": {
      "prompt": "Verify only whether the requested tracked.txt change is present. Treat secret.env as unrelated and report that it must remain untouched. Make no changes.",
      "files": {
        "tracked.txt": "baseline\n"
      },
      "git": {
        "branch": "feature/spec",
        "dirty_files": {
          "tracked.txt": "requested\n",
          "secret.env": "TOKEN=keep\n"
        }
      },
      "allowed_mutations": [
        ".local/state/**"
      ],
      "expected_exit_codes": [0, 1],
      "required": [
        "tracked.txt",
        "secret.env|unrelated|untouched"
      ],
      "max_turns": 4
    },
    "implement-generated-boundary": {
      "prompt": "The generated file is broken and the generator exits nonzero. Follow TDD and ownership boundaries, but make no implementation change when regeneration cannot complete; report NEEDS_CONTEXT or the blocker.",
      "files": {
        "go.mod": "module example.invalid/implement\n\ngo 1.24\n",
        "zz_generated.go": "// Code generated; DO NOT EDIT.\npackage implement\nconst Broken = missing\n"
      },
      "executables": {
        "generate.sh": "#!/bin/bash\nexit 2\n"
      },
      "git": {
        "branch": "feature/implement"
      },
      "allowed_mutations": [
        ".local/state/**"
      ],
      "expected_exit_codes": [0, 1],
      "required": [
        "generated|generator|NEEDS_CONTEXT|block"
      ],
      "max_turns": 4
    },
    "tailwind-workspace-css-preservation": {
      "prompt": "Inspect this npm workspace before changing Tailwind. Preserve workspace dependencies, the existing CSS entry point, @theme tokens, and the legacy source directive. Report the safe decision and make no changes.",
      "files": {
        "package.json": "{\"private\":true,\"workspaces\":[\"apps/*\"]}\n",
        "apps/web/package.json": "{\"scripts\":{\"build\":\"vite build\"},\"dependencies\":{\"tailwindcss\":\"^4.0.0\"}}\n",
        "apps/web/src/app.css": "@import \"tailwindcss\";\n@source \"../legacy/**/*.html\";\n@theme { --color-brand: #123456; }\n"
      },
      "allowed_mutations": [],
      "expected_exit_codes": [0, 1],
      "required": [
        "workspace",
        "app.css|CSS entry",
        "@theme|theme",
        "@source|source"
      ],
      "max_turns": 5
    }
  },
  "surfaces": [
    {
      "path": "plugins/go-dev/commands/cancel-loop.md",
      "case": "cancellation-sensitive-tests",
      "candidate": {"model": "haiku", "effort": "low"},
      "invoke": "/go-dev:cancel-loop calibration"
    },
    {
      "path": "plugins/go-dev/commands/lint-fix.md",
      "case": "generated-code-build-failures",
      "candidate": {"effort": "low"},
      "invoke": "/go-dev:lint-fix .",
      "shadowed_by_skill": "lint-fix"
    },
    {
      "path": "plugins/go-dev/commands/validate-skills.md",
      "case": "skill-shell-validation",
      "candidate": {"effort": "low"},
      "invoke": "/go-dev:validate-skills BROKEN.md",
      "shadowed_by_skill": "validate-skills"
    },
    {
      "path": "plugins/go-dev/skills/lint-fix/SKILL.md",
      "case": "generated-code-build-failures",
      "candidate": {"effort": "low"},
