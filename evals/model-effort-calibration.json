      "mode": "agent",
      "agent": "go-workflow:implementer-prompt"
    },
    {
      "path": "plugins/go-workflow/agents/quality-review-prompt.md",
      "case": "quality-generated-boundary",
      "pin": {"model": "sonnet"},
      "mode": "agent",
      "agent": "go-workflow:quality-review-prompt"
    },
    {
      "path": "plugins/go-workflow/agents/spec-review-prompt.md",
      "case": "spec-dirty-boundary",
      "pin": {"model": "sonnet"},
      "mode": "agent",
      "agent": "go-workflow:spec-review-prompt"
    },
    {
      "path": "plugins/go-workflow/commands/cancel-loop.md",
      "case": "cancellation-sensitive-tests",
      "candidate": {"model": "haiku", "effort": "low"},
